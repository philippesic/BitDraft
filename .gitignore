.DS_Store
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.ruff_cache/
.pytest_cache/
/build/
/dist/
# Live runs and model/data artifacts stay local; this is not a deletion list.
/runs/**
/data/*
!/data/README.md
/models/*
!/models/README.md
# Publish compact historical results under experiments/; preserve unique local evidence.
/results/**
!/results/README.md
*.gguf
*.safetensors
*.pt
*.pth
.env
.env.*
!.env.example

# Campaign-level authored code/reports stay visible; frozen copies/raw data stay local.
!/runs/
!/runs/*/
!/runs/*.py
!/runs/*/*.py
!/runs/*.sh
!/runs/*/*.sh
!/runs/*.md
!/runs/*/*.md
!/runs/*.patch
!/runs/*/*.patch
!/runs/*.toml
!/runs/*/*.toml
!/runs/*.yaml
!/runs/*/*.yaml
!/runs/*.yml
!/runs/*/*.yml

# Campaign-level authored code/reports stay visible; frozen copies/raw data stay local.
!/results/
!/results/*/
!/results/*.py
!/results/*/*.py
!/results/*.sh
!/results/*/*.sh
!/results/*.md
!/results/*/*.md
!/results/*.patch
!/results/*/*.patch
!/results/*.toml
!/results/*/*.toml
!/results/*.yaml
!/results/*/*.yaml
!/results/*.yml
!/results/*/*.yml
