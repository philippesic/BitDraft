 #include <vector>
 
+// Opt-in consistency for small speculative decode batches. The value is the
+// largest batch that uses single-token arithmetic; 0 preserves normal dispatch.
+static inline int ggml_cuda_decode_consistent_limit() {
+    static const int limit = [] {
+        const char * value = std::getenv("GGML_CUDA_DECODE_CONSISTENT");
+        return value ? std::max(0, std::atoi(value)) : 0;
+    }();
+    return limit;
+}
