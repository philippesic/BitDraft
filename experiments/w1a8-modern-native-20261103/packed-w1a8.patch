+// Fixed finite-reciprocal-v2 A8 quantizer from the retained packed runtime.
+// One token per block; byte codes are token-major. Compile with --ftz=false.
+static __global__ void w1ax_quantize(
+        const float * activations, int64_t k, int8_t * codes, float * scales) {
+    __shared__ uint32_t maxima[256];
+    __shared__ float token_absmax;
+    const int64_t token = blockIdx.x;
+    const float * row = activations + token*k;
+    uint32_t local_max = 0;
+    for (int64_t i = threadIdx.x; i < k; i += blockDim.x) {
+        const uint32_t magnitude = __float_as_uint(row[i]) & 0x7fffffffu;
+        if (magnitude >= 0x7f800000u) __trap(); // never silently quantize NaN/Inf
+        local_max = max(local_max, magnitude);
+    }
+    maxima[threadIdx.x] = local_max;
+    __syncthreads();
+    for (int stride = blockDim.x/2; stride > 0; stride /= 2) {
+        if (threadIdx.x < stride) maxima[threadIdx.x] = max(maxima[threadIdx.x], maxima[threadIdx.x + stride]);
+        __syncthreads();
+    }
+    if (threadIdx.x == 0) {
+        token_absmax = __uint_as_float(maxima[0]);
+        scales[token] = __fdiv_rn(token_absmax, 127.0f);
+    }
+    __syncthreads();
+    const bool zero = (__float_as_uint(token_absmax) & 0x7fffffffu) == 0;
+    const float inv = zero ? 0.0f : __fdiv_rn(127.0f, token_absmax);
+    const bool finite_inv = (__float_as_uint(inv) & 0x7f800000u) != 0x7f800000u;
+    for (int64_t i = threadIdx.x; i < k; i += blockDim.x) {
+        // If the reciprocal overflows on a tiny finite row, retain divide-then-
+        // multiply F64 arithmetic, casting to F32 before integer RNE.
+        const float normalized = zero ? 0.0f : finite_inv ? __fmul_rn(row[i], inv) :
+            __double2float_rn((double) row[i]/(double) token_absmax*127.0);
+        const int code = __float2int_rn(normalized);
+        codes[token*k + i] = (int8_t) max(-127, min(127, code));
+    }
+}
